# Environment of deploy/docker-compose.dokploy.yml. Paste it into the Dokploy
# Environment tab and fill it in; steps are in deploy/DOKPLOY.md. Names only
# here: never commit real values. Leave a variable empty to keep its default.
# Generate secrets with `openssl rand -hex 32`. Use URL-safe values (hex is):
# POSTGRES_PASSWORD, S3_ACCESS_KEY and S3_SECRET_KEY go into URLs unencoded.

# ---- required: server and stores ---------------------------------------------
# Bearer token for /api/*. Any secret.
GUARD_SERVER_TOKEN=
# Password of the Postgres login guard and the gateway share. Any secret.
POSTGRES_PASSWORD=
# Access key of the evidence store. Any value.
S3_ACCESS_KEY=
# Secret key of the evidence store. Any secret.
S3_SECRET_KEY=
# DNS name evidence readers use to reach this host on port 8333. Not localhost.
S3_PUBLIC_HOST=

# ---- required: the app repository (GitHub shown; GitLab is further down) ------
# GitHub repository as owner/name. On github.com it is also the clone source.
GITHUB_REPOSITORY=
# GitHub token that can clone the repository and push agent/<KEY> branches.
GITHUB_TOKEN=
# Clone URL (https://). Needed for GitHub Enterprise and self-managed GitLab.
GUARD_APP_REPO_URL=
# Branch or tag to clone. Default: the repository's default branch.
GUARD_APP_REPO_REF=

# ---- required: agent lane ----------------------------------------------------
# Numeric gid of the host's docker group: getent group docker | cut -d: -f3
DOCKER_GID=
# Master key of the model gateway. LiteLLM requires it to start with sk-.
LITELLM_MASTER_KEY=
# Password of the gateway's Redis cache. Any secret.
REDIS_PASSWORD=
# Anthropic API key. Set it, or CLAUDE_CODE_OAUTH_TOKEN, for Claude models.
ANTHROPIC_API_KEY=
# Claude Code subscription token (claude setup-token). Wins over the API key.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- required unless the app repository commits agents.toml ------------------
# Gateway model both agents use, for example claude-opus-5-5.
GUARD_AGENT_MODEL=
# USD budget of each agent attempt, for example 5.
GUARD_AGENT_BUDGET_USD=
# USD spend per UTC day after which no new attempt starts, for example 50.
GUARD_AGENT_DAILY_USD_CAP=
# Sandbox image pinned by digest: <repo>@sha256:<64 hex>. No default exists.
GUARD_SANDBOX_IMAGE=
# Model of the QA agent only. Default: GUARD_AGENT_MODEL.
GUARD_AGENT_QA_MODEL=
# Model of the Coder agent only. Default: GUARD_AGENT_MODEL.
GUARD_AGENT_CODER_MODEL=
# claude-code, codex, copilot-cli, mini-swe-agent or openhands. Default: claude-code.
GUARD_AGENT_RUNTIME=
# Concurrent sandboxes on this host. Default: 1.
GUARD_AGENT_HOST_SLOTS=

# ---- required unless the app repository commits thresholds.toml --------------
# shadow (decisions are recorded, agents never start) or active.
GUARD_THRESHOLDS_MODE=

# ---- optional: Jira ----------------------------------------------------------
# Jira site, for example https://acme.atlassian.net.
JIRA_BASE_URL=
# Email of the Jira user guard acts as.
JIRA_EMAIL=
# API token of that Jira user.
JIRA_API_TOKEN=
# Secret Jira sends with each webhook to /webhooks/jira.
GUARD_JIRA_WEBHOOK_SECRET=
# Custom field for the Shadow Mode suggestion, for example customfield_10123.
JIRA_SUGGESTED_FIELD=
# Custom field holding acceptance criteria, for example customfield_10050.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
# Priority of bugs filed for pre-existing failures. Default: Highest.
JIRA_PRE_EXISTING_PRIORITY=

# ---- optional: decision engine (Jev) -----------------------------------------
# API key of the Jev decision engine. Optional.
TYPESAFE_API_KEY=
# Base URL of the Jev service, when it is not the default one.
JEV_URL=

# ---- optional: code host ([code_host].kind in target.toml) --------------------
# GitHub API base URL. Only for GitHub Enterprise.
GITHUB_API_URL=
# Secret GitHub signs each webhook to /webhooks/github with.
GUARD_GITHUB_WEBHOOK_SECRET=
# GitLab token, instead of GITHUB_TOKEN, when the code host is GitLab.
GITLAB_TOKEN=
# GitLab project path (group/name) or numeric id.
GITLAB_PROJECT=
# GitLab API base URL. Only for self-managed GitLab.
GITLAB_API_URL=
# Token GitLab sends with each webhook to /webhooks/gitlab.
GUARD_GITLAB_WEBHOOK_SECRET=
# Repository id of agent runs. Default: GITHUB_REPOSITORY or GITLAB_PROJECT.
GUARD_REPO=

# ---- optional: other model providers and telemetry ---------------------------
# OpenAI API key, for openai/ gateway models.
OPENAI_API_KEY=
# Gemini API key, for gemini/ gateway models.
GEMINI_API_KEY=
# OTLP collector endpoint for the gateway's spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP protocol, for example http/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=

# ---- optional: server and agent lane tuning ------------------------------------
# Token for the dashboard.
GUARD_DASHBOARD_TOKEN=
# Period of the memory staleness job, for example 15m. Default: 15 minutes.
GUARD_STALENESS_INTERVAL=
# Postgres URL of a guard_memory_reader login for memory reads.
GUARD_MEMORY_READ_DATABASE_URL=
# Evidence bucket name. Default: guard-evidence.
S3_BUCKET=
# Evidence retention. Default: 14d; keep it equal to [evidence].retention_days.
S3_EVIDENCE_TTL=
# Absolute host path of the agent work dir. Default: /var/lib/guard/agent-work.
GUARD_AGENT_WORK_DIR=
# Sandbox runtime: auto, runc or runsc (gVisor).
GUARD_SANDBOX_RUNTIME=
# Set to 1 to keep each attempt's work dir after the attempt.
GUARD_AGENT_KEEP_WORK=
